---
import MainLayout from '../../layouts/main.astro';

const content = {
	title: "אוסמה אחמרו - מהנדס תוכנה בכיר"
};
---

<MainLayout content={content}>
	<style>
		body::before,
		body::after {
			content: "";
			pointer-events: none;
			z-index: 5;
			width: 100%;
			position: fixed;
			left: 0;
			background: linear-gradient(to bottom, rgb(0, 0, 0), transparent);
			height: 8vh;
		}

		body::before {
			top: 0;
		}

		body::after {
			bottom: 0;
			transform: rotate(180deg);
		}

		.circle-bg {
			background-color: #9E9E9E;
		}

		/* Fade animation styles */
		.fade-section {
			opacity: 0;
			transform: translateY(20px);
			transition: opacity 0.8s ease-out, transform 0.8s ease-out;
		}

		.fade-section.visible {
			opacity: 1;
			transform: translateY(0);
		}

	</style>
	<main class="min-h-screen bg-background text-foreground pt-20">
			<div class="container mx-auto px-6 py-16">
				<div class="max-w-4xl mx-auto">
					<!-- Header Section -->
					<div class="space-y-1 fade-section" id="home" data-delay="200">
						<h1 class="text-2xl text-gray-500 font-medium">
							שלום, אני אוסמה אחמרו
						</h1>
						<h2 class="text-3xl lg:text-4xl font-bold text-foreground leading-tight">
							מהנדס תוכנה בכיר
						</h2>
					</div>

						<!-- Social Media Icons -->
						<div class="flex gap-2 pt-6 fade-section" data-delay="400">
							<a
								href="https://github.com/osama-ahmaro"
								target="_blank"
								rel="noopener noreferrer"
								class="text-gray-400 hover:text-white transition duration-300 ease-in-out border border-gray-800 p-2.5 rounded-lg bg-black hover:bg-gray-600/20"
								aria-label="GitHub"
							>
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
									<path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"></path>
								</svg>
							</a>

							<a
								href="https://linkedin.com/in/osama-ahmaro"
								target="_blank"
								rel="noopener noreferrer"
								class="text-gray-400 hover:text-white transition duration-300 ease-in-out border border-gray-800 p-2.5 rounded-lg bg-gray-black hover:bg-gray-600/20"
								aria-label="LinkedIn"
							>
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
									<path d="M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3H19.6697Z"></path>
								</svg>
							</a>

							<a
								href="mailto:osama@example.com"
								target="_blank"
								rel="noopener noreferrer"
								class="text-gray-400 hover:text-white transition duration-300 ease-in-out border border-gray-800 p-2.5 rounded-lg bg-black hover:bg-gray-600/20"
								aria-label="Email"
							>
								<svg xmlns="http://www.w3.org/2000/svg" width="1.8em" height="1.8em" viewBox="0 0 24 24">
									<path fill="currentColor" d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"></path>
								</svg>
							</a>
						</div>

					<!-- Description Section -->
					<div class="mt-8 fade-section" id="about" data-delay="600">
						<p class="text-xl text-gray-500 leading-relaxed max-w-2xl">
							מהנדס תוכנה בכיר עם ניסיון של יותר מ-6 שנים בפיתוח יישומים המתמקדים במשתמש ומתרחבים. הובלתי פיתוח מוצרי ליבה שאומצו על ידי אלפי משתמשים. מומחה במערכת React ובטכנולוגיות אינטרנט מודרניות, נלהב לבנות פתרונות יעילים וניתנים להרחבה שמניבים השפעה עסקית.
						</p>
					</div>


					<!-- Experience Section -->
					<div class="mt-24 fade-section" id="experience" data-delay="800">
						<div class="grid lg:grid-cols-2 gap-12">
							<!-- Left Side - Header -->
							<div>
								<h3 class="text-3xl font-bold text-foreground mb-2">ניסיון</h3>
								<p class="text-gray-500 text-lg">
									עבדתי עם כמה מהמנהיגים החדשניים ביותר בתעשייה כדי לעזור להם לבנות את המוצרים הטובים ביותר שלהם.
								</p>
							</div>

							<!-- Right Side - Experience List -->
							<div>
								<div class="space-y-1">
									<!-- Experience Entry 1 -->
									<div class="group flex items-start gap-3 py-2 border-b border-gray-800 hover:bg-gray-900/20 transition duration-200 ease-in-out rounded px-2 -mx-2">
										<div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 overflow-hidden grayscale group-hover:grayscale-0 transition duration-300 ease-in-out circle-bg">
											<img src="/mavens.jpeg" alt="Mavens logo" class="w-full h-full object-contain rounded-full" />
										</div>
										<div class="flex-1">
											<div class="text-gray-400 group-hover:text-foreground font-bold text-base transition duration-200 ease-in-out">מהנדס תוכנה בכיר</div>
											<div class="text-gray-500 text-sm">@Mavens, חברת Zynga</div>
										</div>
										<div class="text-gray-500 text-sm">
											Sep 2025 — Present
										</div>
									</div>

									<!-- Experience Entry 2 -->
									<div class="group flex items-start gap-3 py-2 border-b border-gray-800 hover:bg-gray-900/20 transition duration-200 ease-in-out rounded px-2 -mx-2">
										<div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 overflow-hidden grayscale group-hover:grayscale-0 transition duration-300 ease-in-out circle-bg">
											<img src="/khealth.jpeg" alt="KHealth logo" class="w-full h-full object-contain rounded-full" />
										</div>
										<div class="flex-1">
											<div class="text-gray-400 group-hover:text-foreground font-bold text-base transition duration-200 ease-in-out">מהנדס תוכנה</div>
											<div class="text-gray-500 text-sm">@KHealth</div>
										</div>
										<div class="text-gray-500 text-sm">
											Mar 2022 — Jul 2025
										</div>
									</div>

									<!-- Experience Entry 3 -->
									<div class="group flex items-start gap-3 py-2 border-b border-gray-800 hover:bg-gray-900/20 transition duration-200 ease-in-out rounded px-2 -mx-2">
										<div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 overflow-hidden grayscale group-hover:grayscale-0 transition duration-300 ease-in-out circle-bg">
											<img src="/hyperguest.jpeg" alt="HyperGuest logo" class="w-full h-full object-contain rounded-full" />
										</div>
										<div class="flex-1">
											<div class="text-gray-400 group-hover:text-foreground font-bold text-base transition duration-200 ease-in-out">מהנדס תוכנה</div>
											<div class="text-gray-500 text-sm">@HyperGuest</div>
										</div>
										<div class="text-gray-500 text-sm">
											Jun 2021 — Mar 2022
										</div>
									</div>

									<!-- Experience Entry 4 -->
									<div class="group flex items-start gap-3 py-2 hover:bg-gray-900/20 transition duration-200 ease-in-out rounded px-2 -mx-2">
										<div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 overflow-hidden grayscale group-hover:grayscale-0 transition duration-300 ease-in-out circle-bg">
											<img src="/sakani.jpeg" alt="Sakani logo" class="w-full h-full object-contain rounded-full" />
										</div>
										<div class="flex-1">
											<div class="text-gray-400 group-hover:text-foreground font-bold text-base transition duration-200 ease-in-out">מהנדס תוכנה</div>
											<div class="text-gray-500 text-sm">@Sakani</div>
										</div>
										<div class="text-gray-500 text-sm">
											Apr 2019 — Jun 2021
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>

					<!-- Languages Section -->
					<div class="mt-24 fade-section" id="contact" data-delay="1000">
						<div class="grid lg:grid-cols-2 gap-12">
							<!-- Left Side - Header -->
							<div>
								<h3 class="text-3xl font-bold text-foreground mb-2">שפות</h3>
								<p class="text-gray-500 text-lg">
									כישורי תקשורת רב-לשוניים שעוזרים לי להתחבר עם צוותים ולקוחות מגוונים ברחבי העולם.
								</p>
							</div>

							<!-- Right Side - Languages List -->
							<div>
								<div class="space-y-1">
									<!-- Arabic -->
									<div class="group flex items-start gap-3 py-2 border-b border-gray-800 hover:bg-gray-900/20 transition duration-200 ease-in-out rounded px-2 -mx-2">
										<div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 overflow-hidden circle-bg">
											<span class="text-white font-bold text-sm">ع</span>
										</div>
										<div class="flex-1">
											<div class="text-gray-400 group-hover:text-foreground font-bold text-base transition duration-200 ease-in-out">ערבית</div>
											<div class="text-gray-500 text-sm">(שפת אם)</div>
										</div>
									</div>

									<!-- English -->
									<div class="group flex items-start gap-3 py-2 border-b border-gray-800 hover:bg-gray-900/20 transition duration-200 ease-in-out rounded px-2 -mx-2">
										<div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 overflow-hidden circle-bg">
											<span class="text-white font-bold text-sm">EN</span>
										</div>
										<div class="flex-1">
											<div class="text-gray-400 group-hover:text-foreground font-bold text-base transition duration-200 ease-in-out">אנגלית</div>
											<div class="text-gray-500 text-sm">(שוטף)</div>
										</div>
									</div>

									<!-- Hebrew -->
									<div class="group flex items-start gap-3 py-2 hover:bg-gray-900/20 transition duration-200 ease-in-out rounded px-2 -mx-2">
										<div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 overflow-hidden circle-bg">
											<span class="text-white font-bold text-sm">ע</span>
										</div>
										<div class="flex-1">
											<div class="text-gray-400 group-hover:text-foreground font-bold text-base transition duration-200 ease-in-out">עברית</div>
											<div class="text-gray-500 text-sm">(יסודי)</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</main>

<script>
	// Fade animation system
	let fadeObserver: IntersectionObserver | null = null;
	
	function initFadeAnimations() {
		const fadeSections = document.querySelectorAll('.fade-section');
		
		// Clean up existing observer
		if (fadeObserver) {
			fadeObserver.disconnect();
		}
		
		fadeObserver = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					const delay = parseInt(entry.target.getAttribute('data-delay') || '0');
					setTimeout(() => {
						entry.target.classList.add('visible');
					}, delay);
					fadeObserver?.unobserve(entry.target);
				}
			});
		}, {
			threshold: 0.1,
			rootMargin: '0px 0px -50px 0px'
		});
		
		fadeSections.forEach(section => {
			fadeObserver?.observe(section);
		});
	}

	// Initialize fade animations on load
	document.addEventListener('DOMContentLoaded', () => {
		initFadeAnimations();
	});
</script>
</MainLayout>
