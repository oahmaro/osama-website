---
import MainLayout from '../../layouts/main.astro';
import RippleGrid from '../../components/bits/ripple-grid.tsx';
import { FaGithub, FaLinkedin } from 'react-icons/fa';
import { BiLogoGmail } from 'react-icons/bi';

const content = {
	title: "אוסמה אחמרו - מהנדס תוכנה בכיר"
};
---

<MainLayout content={content}>
	<style>
		body::before,
		body::after {
			content: "";
			pointer-events: none;
			z-index: 5;
			width: 100%;
			position: fixed;
			left: 0;
			background: linear-gradient(to bottom, var(--background), transparent);
			height: 8vh;
			transition: opacity 0.6s cubic-bezier(0.2, 0, 0.4, 1);
		}
		
		/* Hide gradient pseudo-elements during theme transition */
		body.theme-transitioning::before,
		body.theme-transitioning::after {
			opacity: 0;
		}

		body::before {
			top: 0;
		}

		body::after {
			bottom: 0;
			transform: rotate(180deg);
		}

		.circle-bg {
			background-color: var(--muted);
			border: 1px solid var(--border);
		}
		
		/* Lighter backgrounds for company logos in light theme */
		:not(.dark) .circle-bg {
			background-color: var(--secondary);
		}

		/* Fade animation styles */
		.fade-section {
			opacity: 0;
			transform: translateY(20px);
			transition: opacity 0.8s ease-out, transform 0.8s ease-out;
		}

		.fade-section.visible {
			opacity: 1;
			transform: translateY(0);
		}

	</style>
	<main class="min-h-screen bg-background text-foreground pt-20">
			<div class="container mx-auto px-6 py-16">
				<div class="max-w-4xl mx-auto">
					<!-- Header and About Section with Ripple Grid Background -->
					<div class="relative">
						<!-- Ripple Grid Background -->
						<div class="absolute inset-0 -m-6 rounded-lg overflow-hidden fade-section" data-delay="100">
							<RippleGrid 
								rippleIntensity={0.04}
								gridSize={12}
								gridThickness={25}
								fadeDistance={100}
								vignetteStrength={0.75}
								glowIntensity={0.05}
								opacity={0.35}
								mouseInteraction={true}
								mouseInteractionRadius={1.5}
								client:load
								enableRainbow={true}
								
							/>
						</div>

						<!-- Header Section -->
						<div class="relative z-10 fade-section" id="home" data-delay="200">
							<div class="space-y-1 p-6">
								<h1 class="text-2xl text-muted-foreground font-medium">
									שלום, אני אוסמה אחמרו
								</h1>
								<h2 class="text-3xl lg:text-4xl font-bold text-foreground leading-tight">
									מהנדס תוכנה
								</h2>
							</div>
						</div>

						<!-- Social Media Icons -->
						<div class="relative z-10 flex gap-2 pt-6 px-6 fade-section" data-delay="400">
							<a 
								href="https://github.com/osama-ahmaro" 
								target="_blank" 
								rel="noopener noreferrer"
								class="flex items-center justify-center text-muted-foreground hover:text-foreground transition duration-300 ease-in-out border border-border p-3 rounded-lg bg-card hover:bg-accent w-13 h-13"
								aria-label="GitHub"
							>
								<FaGithub size={22} />
							</a>
							
							<a 
								href="https://linkedin.com/in/osama-ahmaro" 
								target="_blank" 
								rel="noopener noreferrer"
								class="flex items-center justify-center text-muted-foreground hover:text-foreground transition duration-300 ease-in-out border border-border p-3 rounded-lg bg-card hover:bg-accent w-13 h-13"
								aria-label="LinkedIn"
							>
								<FaLinkedin size={22} />
							</a>
							
							<a 
								href="mailto:osama@example.com" 
								target="_blank" 
								rel="noopener noreferrer"
								class="flex items-center justify-center text-muted-foreground hover:text-foreground transition duration-300 ease-in-out border border-border p-3 rounded-lg bg-card hover:bg-accent w-13 h-13"
								aria-label="Gmail"
							>
								<BiLogoGmail size={22} />
							</a>
						</div>

						<!-- Description Section -->
						<div class="relative z-10 mt-8 fade-section" id="about" data-delay="600">
							<div class="p-6">
								<p class="text-xl text-muted-foreground leading-relaxed max-w-2xl">
									מהנדס תוכנה בכיר עם ניסיון של יותר מ-6 שנים בפיתוח יישומים המתמקדים במשתמש ומתרחבים. הובלתי פיתוח מוצרי ליבה שאומצו על ידי אלפי משתמשים. מומחה במערכת React ובטכנולוגיות אינטרנט מודרניות, נלהב לבנות פתרונות יעילים וניתנים להרחבה שמניבים השפעה עסקית.
								</p>
							</div>
						</div>
					</div>


					<!-- Experience Section -->
					<div class="mt-24 fade-section" id="experience" data-delay="200">
						<div class="grid lg:grid-cols-2 gap-12">
							<!-- Left Side - Header -->
							<div>
								<h3 class="text-3xl font-bold text-foreground mb-2">ניסיון</h3>
								<p class="text-muted-foreground text-lg">
									עבדתי עם כמה מהמנהיגים החדשניים ביותר בתעשייה כדי לעזור להם לבנות את המוצרים הטובים ביותר שלהם.
								</p>
							</div>

							<!-- Right Side - Experience List -->
							<div>
								<div class="space-y-1">
									<!-- Experience Entry 1 -->
									<div class="group flex items-start gap-3 py-2 border-b border-border hover:bg-accent transition duration-200 ease-in-out rounded px-2 -mx-2 select-none">
										<div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 overflow-hidden grayscale group-hover:grayscale-0 transition duration-300 ease-in-out circle-bg">
											<img src="/mavens.jpeg" alt="Mavens logo" class="w-full h-full object-contain rounded-full" />
										</div>
										<div class="flex-1">
											<div class="text-muted-foreground group-hover:text-foreground font-bold text-base transition duration-200 ease-in-out">מהנדס תוכנה בכיר</div>
											<div class="text-muted-foreground text-sm">@Mavens, חברת Zynga</div>
										</div>
										<div class="text-muted-foreground text-sm">
											Sep 2025 — Present
										</div>
									</div>

									<!-- Experience Entry 2 -->
									<div class="group flex items-start gap-3 py-2 border-b border-border hover:bg-accent transition duration-200 ease-in-out rounded px-2 -mx-2 select-none">
										<div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 overflow-hidden grayscale group-hover:grayscale-0 transition duration-300 ease-in-out circle-bg">
											<img src="/khealth.jpeg" alt="KHealth logo" class="w-full h-full object-contain rounded-full" />
										</div>
										<div class="flex-1">
											<div class="text-muted-foreground group-hover:text-foreground font-bold text-base transition duration-200 ease-in-out">מהנדס תוכנה</div>
											<div class="text-muted-foreground text-sm">@KHealth</div>
										</div>
										<div class="text-muted-foreground text-sm">
											Mar 2022 — Jul 2025
										</div>
									</div>

									<!-- Experience Entry 3 -->
									<div class="group flex items-start gap-3 py-2 border-b border-border hover:bg-accent transition duration-200 ease-in-out rounded px-2 -mx-2 select-none">
										<div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 overflow-hidden grayscale group-hover:grayscale-0 transition duration-300 ease-in-out circle-bg">
											<img src="/hyperguest.jpeg" alt="HyperGuest logo" class="w-full h-full object-contain rounded-full" />
										</div>
										<div class="flex-1">
											<div class="text-muted-foreground group-hover:text-foreground font-bold text-base transition duration-200 ease-in-out">מהנדס תוכנה</div>
											<div class="text-muted-foreground text-sm">@HyperGuest</div>
										</div>
										<div class="text-muted-foreground text-sm">
											Jun 2021 — Mar 2022
										</div>
									</div>

									<!-- Experience Entry 4 -->
									<div class="group flex items-start gap-3 py-2 hover:bg-accent transition duration-200 ease-in-out rounded px-2 -mx-2">
										<div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 overflow-hidden grayscale group-hover:grayscale-0 transition duration-300 ease-in-out circle-bg">
											<img src="/sakani.jpeg" alt="Sakani logo" class="w-full h-full object-contain rounded-full" />
										</div>
										<div class="flex-1">
											<div class="text-muted-foreground group-hover:text-foreground font-bold text-base transition duration-200 ease-in-out">מהנדס תוכנה</div>
											<div class="text-muted-foreground text-sm">@Sakani</div>
										</div>
										<div class="text-muted-foreground text-sm">
											Apr 2019 — Jun 2021
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>

					<!-- Languages Section -->
					<div class="mt-24 fade-section" id="contact" data-delay="200">
						<div class="grid lg:grid-cols-2 gap-12">
							<!-- Left Side - Header -->
							<div>
								<h3 class="text-3xl font-bold text-foreground mb-2">שפות</h3>
								<p class="text-muted-foreground text-lg">
									כישורי תקשורת רב-לשוניים שעוזרים לי להתחבר עם צוותים ולקוחות מגוונים ברחבי העולם.
								</p>
							</div>

							<!-- Right Side - Languages List -->
							<div>
								<div class="space-y-1">
									<!-- Arabic -->
									<div class="group flex items-start gap-3 py-2 border-b border-border hover:bg-accent transition duration-200 ease-in-out rounded px-2 -mx-2 select-none">
							<div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 overflow-hidden circle-bg">
								<span class="text-foreground font-bold text-sm">AR</span>
							</div>
										<div class="flex-1">
											<div class="text-muted-foreground group-hover:text-foreground font-bold text-base transition duration-200 ease-in-out">ערבית</div>
											<div class="text-muted-foreground text-sm">(שפת אם)</div>
										</div>
									</div>

									<!-- English -->
									<div class="group flex items-start gap-3 py-2 border-b border-border hover:bg-accent transition duration-200 ease-in-out rounded px-2 -mx-2 select-none">
							<div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 overflow-hidden circle-bg">
								<span class="text-foreground font-bold text-sm">EN</span>
							</div>
										<div class="flex-1">
											<div class="text-muted-foreground group-hover:text-foreground font-bold text-base transition duration-200 ease-in-out">אנגלית</div>
											<div class="text-muted-foreground text-sm">(שוטף)</div>
										</div>
									</div>

									<!-- Hebrew -->
									<div class="group flex items-start gap-3 py-2 hover:bg-accent transition duration-200 ease-in-out rounded px-2 -mx-2">
							<div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 overflow-hidden circle-bg">
								<span class="text-foreground font-bold text-sm">HE</span>
							</div>
										<div class="flex-1">
											<div class="text-muted-foreground group-hover:text-foreground font-bold text-base transition duration-200 ease-in-out">עברית</div>
											<div class="text-muted-foreground text-sm">(יסודי)</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</main>

<script>
	// Fade animation system
	let fadeObserver: IntersectionObserver | null = null;
	
	function initFadeAnimations() {
		const fadeSections = document.querySelectorAll('.fade-section');
		
		// Clean up existing observer
		if (fadeObserver) {
			fadeObserver.disconnect();
		}
		
		fadeObserver = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					const delay = parseInt(entry.target.getAttribute('data-delay') || '0');
					setTimeout(() => {
						entry.target.classList.add('visible');
					}, delay);
					fadeObserver?.unobserve(entry.target);
				}
			});
		}, {
			threshold: 0.05,
			rootMargin: '0px 0px -20px 0px'
		});
		
		fadeSections.forEach(section => {
			fadeObserver?.observe(section);
		});
	}

	// Initialize fade animations on load
	document.addEventListener('DOMContentLoaded', () => {
		initFadeAnimations();
	});
</script>
</MainLayout>
